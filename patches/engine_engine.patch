+    def _prof_tick(self) -> None:
+        import torch.profiler as tp
+
+        p = self._prof
+        p["n"] += 1
+        if p["obj"] is None and p["n"] == p["skip"]:
+            torch.cuda.synchronize()
+            p["obj"] = tp.profile(
+                activities=[tp.ProfilerActivity.CPU, tp.ProfilerActivity.CUDA])
+            p["obj"].__enter__()
+            logger.info_rank0("decode profiler: recording")
+        elif p["obj"] is not None and p["n"] == p["skip"] + p["count"]:
+            torch.cuda.synchronize()
+            p["obj"].__exit__(None, None, None)
+            with open("/tmp/prof_decode.txt", "w") as f:
+                f.write(p["obj"].key_averages().table(
+                    sort_by="cuda_time_total", row_limit=100))
+            p["obj"].export_chrome_trace("/tmp/prof_decode.json")
+            p["done"] = True
+            p["obj"] = None
+            logger.info_rank0("decode profiler: dumped /tmp/prof_decode.txt (+json)")
+
