+    for i, req in enumerate(batch.reqs):
+        if type(req).__name__ == "ChunkedReq":  # a non-final chunk samples nothing
+            continue
+        ids = req.input_ids[: req.device_len].to("cpu", torch.int64).numpy().tobytes()
+        key = hashlib.sha1(ids).hexdigest()[:16]
+        torch.save({"uid": req.uid, "prompt_len": req.device_len, "logits": batch_logits[i].detach().cpu()},
+                   f"{_FIRST_LOGITS_DIR}/{key}_{req.uid}.pt")
+
+
+def _prefill_prof_begin(batch):
+    if not _PREFILL_PROF["at"] or batch.is_decode:
+        return None
+    _PREFILL_PROF["n"] += 1
+    if _PREFILL_PROF["n"] != _PREFILL_PROF["at"]:
+        return None
+    import time
+
+    import torch.profiler as tp
+
+    torch.cuda.synchronize()
+    p = tp.profile(activities=[tp.ProfilerActivity.CPU, tp.ProfilerActivity.CUDA])
+    p.__enter__()
+    return (p, time.perf_counter(), int(batch.input_ids.shape[0]))
+
+
+def _prefill_prof_end(pp):
+    import time
+
+    p, t0, ntok = pp
+    torch.cuda.synchronize()
+    wall = time.perf_counter() - t0
+    p.__exit__(None, None, None)
+    with open("/tmp/prof_prefill.txt", "w") as f:
+        f.write(f"prefill forward: {ntok} tokens, wall {wall * 1000:.1f} ms\n")
+        f.write(p.key_averages().table(sort_by="cuda_time_total", row_limit=60))
+    p.export_chrome_trace("/tmp/prof_prefill.json")
+    logger.info_rank0(f"prefill profiler: {ntok} tokens {wall * 1000:.1f} ms -> /tmp/prof_prefill.txt")
