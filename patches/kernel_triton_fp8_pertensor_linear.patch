 # ======================================================================================
+# Small-batch decode (2 <= M <= 8) W8A16 split-K GEMV with an M tile: the weight tile is
+# read ONCE per (n, k) block and dotted with all M activation rows, so the HBM traffic
+# equals the M==1 GEMV instead of the prefill GEMM's latency-bound grid (2026-08-29
+# conc2 profile: _gemm at M=2 took 11.9 ms/step vs 4.95 at M=1 over identical weights).
+# Same W8A16 scheme and fp32 accumulation as _gemv; only the reduction shape differs.
+# ======================================================================================
+@triton.jit
+def _gemv_splitk_m_kernel(
+    a_ptr, w_ptr, part_ptr, N, K, n_kb, kb_per,
+    stride_am, stride_ak, stride_wn, stride_wk, stride_pk, stride_pm, stride_pn,
+    M_TILE: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    n_mask = offs_n < N
+    offs_m = tl.arange(0, M_TILE)
+    kb_start = pid_k * kb_per
+    acc = tl.zeros((M_TILE, BLOCK_N), dtype=tl.float32)
+    for i in range(kb_per):
+        kb = kb_start + i
+        if kb < n_kb:
+            offs_k = kb * BLOCK_K + tl.arange(0, BLOCK_K)
+            k_mask = offs_k < K
+            if e4m3_native_cx():
+                w = tl.load(
+                    w_ptr + offs_n[:, None] * stride_wn + offs_k[None, :] * stride_wk,
+                    mask=n_mask[:, None] & k_mask[None, :], other=0.0,
+                ).to(tl.float32)                               # [N_b, K_b], read ONCE
+            else:
+                w = e4m3_u8_to_f32(tl.load(
+                    w_ptr + offs_n[:, None] * stride_wn + offs_k[None, :] * stride_wk,
+                    mask=n_mask[:, None] & k_mask[None, :], other=0,
+                ))
+            # per-row dot exactly like the M==1 kernel; the tiny [M, N_b] where-add
+            # routes each row's contribution without an indexable accumulator.
+            for m in tl.static_range(M_TILE):
+                a_m = tl.load(a_ptr + m * stride_am + offs_k * stride_ak,
+                              mask=k_mask, other=0.0).to(tl.float32)
+                c = tl.sum(w * a_m[None, :], axis=1)           # [N_b]
+                acc = acc + tl.where(offs_m[:, None] == m, c[None, :], 0.0)
+    p_ptrs = part_ptr + pid_k * stride_pk + offs_m[:, None] * stride_pm + offs_n[None, :] * stride_pn
+    tl.store(p_ptrs, acc, mask=n_mask[None, :])
+
+
+@triton.jit
+def _splitk_reduce_m_kernel(
+    part_ptr, scale_ptr, out_ptr, N, SPLIT_K: tl.constexpr,
+    stride_pk, stride_pm, stride_pn, stride_om,
+    BLOCK: tl.constexpr, OUT: tl.constexpr,
+):
+    m = tl.program_id(1)
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < N
+    acc = tl.zeros((BLOCK,), dtype=tl.float32)
+    for k in tl.static_range(SPLIT_K):
+        acc += tl.load(part_ptr + k * stride_pk + m * stride_pm + offs * stride_pn,
+                       mask=mask, other=0.0)
+    scale = tl.load(scale_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    tl.store(out_ptr + m * stride_om + offs, (acc * scale).to(OUT), mask=mask)
+
+
+def _gemv_m(a: torch.Tensor, weight: torch.Tensor, weight_scale: torch.Tensor,
+            out_dtype: torch.dtype) -> torch.Tensor:
+    """2 <= M <= 8 split-K GEMV. ``a`` [M, K] bf16; ``weight`` [N, K] fp8."""
+    M, K = a.shape
+    N = weight.shape[0]
+    BLOCK_K = 128
+    n_kb = triton.cdiv(K, BLOCK_K)
+    BLOCK_N = 16
+    n_tiles = triton.cdiv(N, BLOCK_N)
+    split_k = max(1, min(1536 // n_tiles, n_kb))
+    split_k = 1 << (split_k.bit_length() - 1)  # pow2 -> stable reduction order
+    kb_per = triton.cdiv(n_kb, split_k)
+    part = torch.empty((split_k, M, N), dtype=torch.float32, device=a.device)
+    _gemv_splitk_m_kernel[(n_tiles, split_k)](
+        a, weight, part, N, K, n_kb, kb_per,
+        a.stride(0), a.stride(1), weight.stride(0), weight.stride(1),
+        part.stride(0), part.stride(1), part.stride(2),
+        M_TILE=M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K, num_warps=1,
+    )
+    compute = out_dtype if out_dtype in _TL_DTYPE else torch.bfloat16
+    out = torch.empty((M, N), dtype=compute, device=a.device)
+    _splitk_reduce_m_kernel[(triton.cdiv(N, 256), M)](
+        part, weight_scale, out, N, split_k,
+        part.stride(0), part.stride(1), part.stride(2), out.stride(0),
+        BLOCK=256, OUT=_TL_DTYPE[compute], num_warps=2,
+    )
+    return out
+
+
