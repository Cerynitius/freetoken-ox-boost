 @triton.jit
+def _e2m1_to_f32(code):
+    """e2m1 nibble -> fp32 by building the IEEE bits (exact; replaces the 16-entry LUT
+    gather): |v| = 0, 0.5 (m=1), else 2^(e-1) * (1 + mant/2) with m = e<<1 | mant."""
+    m = code & 7
+    e = m >> 1
+    bits = tl.where(m >= 2, ((e + 126) << 23) | ((m & 1) << 22), tl.where(m == 1, 126 << 23, 0))
+    bits = bits | ((code & 8) << 28)
+    return bits.to(tl.float32, bitcast=True)
+
+
+@triton.jit
+def _e2m1_to_bf16(code):
+    """e2m1 nibble -> bf16 via its bit pattern (exact)."""
+    m = code & 7
+    e = m >> 1
+    bits = tl.where(m >= 2, ((e + 126) << 7) | ((m & 1) << 6), tl.where(m == 1, 126 << 7, 0))
+    bits = bits | ((code & 8) << 12)
+    return bits.to(tl.int16).to(tl.bfloat16, bitcast=True)
+
