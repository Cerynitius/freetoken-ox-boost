 import torch
 import triton
 import triton.language as tl
 
+# P.V precision. Both operands are fp32 in-kernel (P = exp(s - m) in fp32,
+# V = bf16 latent rows widened). tl.dot's default "tf32" feeds P to the tensor cores TRUNCATED to
+# a 10-bit mantissa (no cvt.rna in the PTX) -> every attention weight shrinks by 2^-11 on
+# average, a biased ~-0.03% scale on the output (the softmax denominator l uses the untruncated
+# p). Default "tf32rna": P is rounded to TF32 with round-to-nearest (cvt.rna.tf32.f32) before the
+# same tensor-core dot, so the hardware truncation is a no-op and the per-weight error is unbiased
+# (+-2^-11, 8x finer than HF, which rounds P to bf16 before its bf16 matmul); V is bf16-exact in
+# TF32, accumulation stays fp32. HF bit-parity is impossible with online softmax anyway. The Q.K
+# dots stay at the default: Q and K are bf16-exact, which TF32 represents exactly.
+#   FREETOKEN_DSA_PV_TF32=1        old behaviour (truncated, A/B)
+#   FREETOKEN_DSA_PV_PREC=tf32x3   3xTF32 split (fp32-level; ~2.7x the prefill attention time)
+# ("ieee" CUDA-core products need 133 KB of shared memory at these tiles: over sm_120's 99 KB.)
+_PV_PREC = (
+    "tf32" if os.environ.get("FREETOKEN_DSA_PV_TF32", "0") == "1"
+    else os.environ.get("FREETOKEN_DSA_PV_PREC", "tf32rna")
+)
+assert _PV_PREC in ("tf32rna", "tf32x3", "tf32"), f"FREETOKEN_DSA_PV_PREC={_PV_PREC!r}"
+_PV_DOT = "tf32" if _PV_PREC == "tf32rna" else _PV_PREC   # tl.dot input_precision
+_PV_RNA = _PV_PREC == "tf32rna"
+
+@triton.jit
+def _pv_round(p, RNA: tl.constexpr):
+    """fp32 -> TF32 round-to-nearest (low 13 bits zeroed), so the tensor core's truncation of the
+    fp32 operand is exact; identity when RNA is off."""
+    if RNA:
+        return tl.inline_asm_elementwise("cvt.rna.tf32.f32 $0, $1;", "=r,r", [p],
+                                         dtype=tl.float32, is_pure=True, pack=1)
+    else:
+        return p
+
