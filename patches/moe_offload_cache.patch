+        H = views[0].shape[2] * 2
+        I = views[3].shape[2] * 2
+        gq, gs, dq, ds = b12x_views(views, H, I)
+        E = self.num_experts
+        ones = torch.ones(E, dtype=torch.float32, device=self.device)
+        for m in sorted({min(1024, max_tokens), max_tokens}):
+            x = torch.zeros(m, H, dtype=torch.bfloat16, device=self.device)
+            ids = (torch.arange(m * 8, device=self.device) % E).view(m, 8).to(torch.int32)
+            w = torch.full((m, 8), 0.125, dtype=torch.float32, device=self.device)
+            b12x_fused_experts(x, gq, gs, ones, dq, ds, ones, w, ids, "silu", False)
