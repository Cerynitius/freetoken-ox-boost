+    def elastic_retire_until(self, need_bytes: int, min_slots: int) -> tuple[int, int]:
+        """Retire top chunks until ``need_bytes`` of physical memory are released (caller
+        synchronized the device). Returns (bytes released, chunks retired)."""
+        from freetoken.engine.elastic import EXPERT_CHUNK
+
+        freed = k = 0
+        while freed < need_bytes and (self._el_mapped - 1) * EXPERT_CHUNK >= min_slots:
+            c = self._el_mapped - 1
+            a, b = self._el_chunk_slots(c)
+            ids = self.id_of_slot[a:b].long()
+            ids = ids[ids >= 0]
+            if ids.numel():
+                self.slot_for_id.view(-1)[ids] = -1
+            self.id_of_slot[a:b] = -1
+            self.usage[a:b] = torch.iinfo(self.usage.dtype).max
+            torch.cuda.synchronize(self.device)
+            for reg, rb in self._el_regions:
+                freed += reg.maps[c * EXPERT_CHUNK * rb][0]
+                reg.unmap(c * EXPERT_CHUNK * rb)
+            self._el_mapped -= 1
+            k += 1
+        return freed, k
+
+    def elastic_restore(self, k: int) -> None:
+        """Map ``k`` retired chunks back as empty, first-choice victim slots."""
+        from freetoken.engine.elastic import EXPERT_CHUNK
+        from freetoken.kernel.vmm import align_up
+
+        for _ in range(k):
+            c = self._el_mapped
+            a, b = self._el_chunk_slots(c)
+            for reg, rb in self._el_regions:
+                reg.map(c * EXPERT_CHUNK * rb, align_up((b - a) * rb, reg.gran))
+            self.id_of_slot[a:b] = -1
+            self.usage[a:b] = -(1 << 62)
+            self._el_mapped += 1
