+    def b12x_warmup(self, max_tokens: int) -> None:
+        """Compile the b12x kernels and size their workspace for ``max_tokens`` at init
+        (garbage weights in double-buffer 0, output discarded) so neither the JIT nor the
+        ~1 GB workspace lands inside the first long prefill."""
