+    def _el_chunk_slots(self, c: int) -> tuple[int, int]:
+        from freetoken.engine.elastic import EXPERT_CHUNK
+
+        return c * EXPERT_CHUNK, min((c + 1) * EXPERT_CHUNK, self.cache_size)
