+    # ---- elastic expert slots (engine/elastic.py): top-of-range chunks are retired
+    # (experts evicted, usage pinned at INT64_MAX so no ensure picks them, bank bytes
+    # unmapped) to give their VRAM to the KV pool, and restored when KV shrinks.
+    def _elastic_bank_alloc(self, name: str, head: torch.Tensor) -> torch.Tensor:
+        from freetoken.engine.elastic import EXPERT_CHUNK
+        from freetoken.kernel.vmm import VmmRegion, align_up
+
+        if not hasattr(self, "_el_regions"):
+            self._el_regions = []
+            self._el_mapped = -(-self.cache_size // EXPERT_CHUNK)  # chunks mapped
+        rb = head[0].numel() * head.element_size()
+        s_alloc = self._el_mapped * EXPERT_CHUNK
+        reg = VmmRegion(s_alloc * rb, self.device)
+        assert (EXPERT_CHUNK * rb) % reg.gran == 0, (name, rb)
+        for c in range(self._el_mapped):
+            n = min(EXPERT_CHUNK, self.cache_size - c * EXPERT_CHUNK)
+            reg.map(c * EXPERT_CHUNK * rb, align_up(n * rb, reg.gran))
+        self._el_regions.append((reg, rb))
+        return reg.bytes_tensor()[: self.cache_size * rb].view(head.dtype).view(
+            self.cache_size, *head.shape[1:])
