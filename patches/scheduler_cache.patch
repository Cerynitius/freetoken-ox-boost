+    def _clone_slot_for_tree(self, src: int) -> int:
+        """copy-on-donate: the tree receives a PRIVATE clone of the snapshot slot instead
+        of taking ownership of the request's slot. Ownership transfer shares one slot id
+        between the live request path and the tree; any late write through a retained
+        alias (in-flight batch staging, ping-pong bookkeeping) then poisons every future
+        hit of that branch -- the residual ~3% corruption the admission barriers could
+        not close. A private clone severs every alias. The copy is issued on the current
+        (scheduler) stream AFTER the donate barrier's full device sync, so the source is
+        quiescent; ~1 MB per snapshot, microseconds."""
+        self.ensure_mamba_slots(1)
+        dst = self.linear_state_pool.alloc(1)[0]
+        self.linear_state_pool.copy_from(src, dst)
+        if _GDN_DEBUG:
+            _logger_gdn.info(
+                "gdn-clone src=%d dst=%d src_cksum=%.3f dst_cksum=%.3f",
+                src, dst,
+                self.linear_state_pool.debug_checksum(src),
+                self.linear_state_pool.debug_checksum(dst),
+            )
+        return dst
 
