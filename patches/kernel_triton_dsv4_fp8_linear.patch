+def grouped_fp8_gemv(x: torch.Tensor, weight: torch.Tensor, sb: torch.Tensor,
+                     groups: int, out_dtype: torch.dtype = torch.bfloat16) -> torch.Tensor:
+    """Small-batch grouped projection: x [M, G*KG] (or [G*KG]) bf16 -> out [M, G*R].
+    weight [G*R, KG] fp8 with 128x128 e8m0 scales sb [G*R//128, KG//128]
+    (the checkpoint-native wo_a layout). Single launch for all groups AND all M
+    rows (M is a constexpr tile; meant for decode batches, M <= ~16). Activation
+    quantized per 128-block with the reference ue8m0 rule; numerics match
+    block_fp8_linear group-by-group."""
+    squeeze = x.dim() == 1
+    x2 = x.reshape(1, -1) if squeeze else x
+    M = x2.shape[0]
+    N, KG = weight.shape
+    R = N // groups
+    if sb.dtype != torch.uint8:
+        sb = sb.view(torch.uint8)  # e8m0fnu -> raw exponent codes (kernel convention)
+    a_fp8, sa = act_quant_fp8(x2)
+    BLOCK_N, split_k, num_warps = 16, 8, 1
+    split_k = max(1, min(split_k, KG // 128))
+    n_tiles = triton.cdiv(N, BLOCK_N)
+    part = torch.empty((split_k, M, N), dtype=torch.float32, device=x.device)
+    m_pow2 = 1 << (M - 1).bit_length() if M > 1 else 1
+    _fp8_act_gemv_grouped_splitk_kernel[(n_tiles, split_k)](
+        e4m3_kernel_view(a_fp8), sa, e4m3_kernel_view(weight), sb, part, N, KG, M,
+        a_fp8.stride(0), a_fp8.stride(1), sa.stride(0),
+        weight.stride(0), weight.stride(1),
+        sb.stride(0), sb.stride(1),
+        part.stride(0), part.stride(1), part.stride(2),
+        M_POW2=m_pow2, R_PER_G=R, BLOCK_N=BLOCK_N, SPLIT_K=split_k, num_warps=num_warps,
+    )
+    out = torch.empty((M, N), dtype=out_dtype, device=x.device)
+    part2 = part.view(split_k, M * N)
+    out2 = out.view(M * N)
+    _splitk_reduce_kernel[(triton.cdiv(M * N, 256),)](
+        part2, out2, M * N, split_k, part2.stride(0), part2.stride(1),
+        BLOCK=256, OUT=_TL_DTYPE[out_dtype], num_warps=2,
+    )
+    return out2.view(N) if squeeze else out
+
