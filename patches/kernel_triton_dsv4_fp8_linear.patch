+@triton.jit
+def _fp8_act_gemv_grouped_splitk_kernel(
+    a_ptr,            # [M, G*KG] float8 activations (flattened groups)
+    sa_ptr,           # [M, G*KG//128] uint8 e8m0 act codes
+    w_ptr,            # [G*R, KG] float8 weight (groups stacked on N)
+    sb_ptr,           # [G*R//128, KG//128] uint8 e8m0 weight codes
+    part_ptr,         # [SPLIT_K, M, G*R] fp32
+    N, KG, M,
+    stride_am, stride_ak, stride_sam,
+    stride_wn, stride_wk, stride_sbn, stride_sbk,
+    stride_pk, stride_pm, stride_pn,
+    M_POW2: tl.constexpr, R_PER_G: tl.constexpr,
+    BLOCK_N: tl.constexpr, SPLIT_K: tl.constexpr,
+):
+    """Grouped variant of the decode GEMV: output row n belongs to group n // R_PER_G
+    and contracts against that group's input slice a[g*KG:(g+1)*KG]. One launch for
+    all groups (the per-group-loop alternative costs G launches per layer and eats
+    the FP8 win in launch overhead). BLOCK_N must divide R_PER_G so a tile never
+    straddles a group boundary."""
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    n_mask = offs_n < N
+    g = (pid_n * BLOCK_N) // R_PER_G
+    sn = offs_n // 128
+    k_per = KG // SPLIT_K
+    k_start = pid_k * k_per
+    offs_m = tl.arange(0, M_POW2)
+    m_mask = offs_m < M
+    acc = tl.zeros((M_POW2, BLOCK_N), dtype=tl.float32)
+    for k0 in range(0, k_per, 128):
+        offs_k = k_start + k0 + tl.arange(0, 128)
+        a = tl.load(
+            a_ptr + offs_m[:, None] * stride_am + (g * KG + offs_k)[None, :] * stride_ak,
+            mask=m_mask[:, None], other=0.0,
+        ).to(tl.float32)                                              # [M, 128]
+        w_ptrs = w_ptr + offs_n[:, None] * stride_wn + offs_k[None, :] * stride_wk
+        if e4m3_native_cx():
+            w = tl.load(w_ptrs, mask=n_mask[:, None], other=0.0).to(tl.float32)
+        else:
+            w = e4m3_u8_to_f32(tl.load(w_ptrs, mask=n_mask[:, None], other=0))
+        kb = (k_start + k0) // 128
+        sb_code = tl.load(sb_ptr + sn * stride_sbn + kb * stride_sbk, mask=n_mask, other=0)
+        scb = tl.exp2(sb_code.to(tl.float32) - 127.0)                  # [BLOCK_N]
+        sa_code = tl.load(
+            sa_ptr + offs_m * stride_sam + (g * KG) // 128 + kb, mask=m_mask, other=0)
+        sca = tl.exp2(sa_code.to(tl.float32) - 127.0)                  # [M]
+        acc += tl.sum(w[None, :, :] * a[:, None, :], axis=2) * scb[None, :] * sca[:, None]
+    p_ptrs = (part_ptr + pid_k * stride_pk + offs_m[:, None] * stride_pm
+              + offs_n[None, :] * stride_pn)
+    tl.store(p_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])
+
